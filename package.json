{
	"name": "cognito-at-edge",
	"packageManager": "yarn@4.14.1",
	"version": "1.5.4",
	"repository": {
		"type": "git",
		"url": "https://github.com/timkaas/cognito-at-edge"
	},
	"description": "Cognito authentication made easy to protect your website with CloudFront and Lambda@Edge.",
	"author": "AWS Builder Labs <aws-builder-labs@amazon.com>, LunaPinc <timkaas@lunapinc.com> and contributors",
	"license": "Apache-2.0",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"/dist"
	],
	"scripts": {
		"test": "vitest run --no-watch --no-coverage",
		"test:coverage": "vitest run --coverage",
		"format": "prettier --config .prettierrc.toml 'src/**/*.ts' --write --list-different",
		"lint": "yarn format && eslint . --ext .ts",
		"build": "yarn lint && tsc",
		"test:watch": "vitest",
		"prepare": "husky"
	},
	"dependencies": {
		"aws-jwt-verify": "^5.1.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/aws-lambda": "^8.10.161",
		"@types/node": "^25.6.0",
		"@vitest/coverage-v8": "^2.1.8",
		"eslint": "^10.2.1",
		"globals": "^17.5.0",
		"husky": "^9.1.7",
		"prettier": "^3.8.3",
		"prettier-plugin-organize-imports": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.0",
		"vitest": "^2.1.8"
	},
	"engines": {
		"node": ">=14.10.0"
	},
	"keywords": [
		"aws",
		"cognito",
		"userpool",
		"cloudfront",
		"lambda",
		"edge",
		"private",
		"website"
	]
}
